---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PromptCard from '../../components/PromptCard.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';

export async function getStaticPaths() {
  return [
    { params: { slug: 'sample-prompt' } },
    { params: { slug: 'mastering-claude-37-sonnet-system-architecture-prompts' } }
  ];
}

const { slug } = Astro.params;
---

<BaseLayout title={`Blog Post: ${slug}`}>
  <article className="mx-auto max-w-4xl px-4 py-12">
    <h1 className="text-3xl font-extrabold text-white sm:text-4xl mb-4 capitalize">
      {slug.replace(/-/g, ' ')}
    </h1>

    <PromptCard
      title="Claude 3.7 System Architect Prompt"
      tool="Claude"
      promptText="[SYSTEM PROMPT: STAFF ARCHITECT] Analyze code for performance, security, and type safety."
    />
  </article>
</BaseLayout>
