---
import BaseLayout from '../layouts/BaseLayout.astro';
import PromptCard from '../components/PromptCard.astro';
import VideoEmbed from '../components/VideoEmbed.astro';
---

<BaseLayout title="PromptCraft Blog — Prompt Engineering & Tech Tips">
  <main className="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
    <div className="text-center space-y-4 max-w-3xl mx-auto mb-12">
      <span className="inline-block rounded-full border border-violet-500/30 bg-violet-500/10 px-3 py-1 text-xs font-semibold text-violet-300">
        Cloudflare Pages SSG Target
      </span>
      <h1 className="text-4xl font-extrabold text-white sm:text-5xl tracking-tight">
        Engineering-Grade Prompts & <span className="text-violet-400">Tech Tips Blog</span>
      </h1>
      <p className="text-slate-300 text-sm sm:text-base">
        Tested prompt templates, system instructions, and technical guides for Claude 3.7, ChatGPT o3, Midjourney v6.1, Suno v4, and Cursor IDE.
      </p>
    </div>

    <PromptCard
      title="Principal Software Architect & Code Reviewer"
      description="Enforces SOLID principles, security standards, modular structure, and performance benchmarks for TypeScript/React/Node ecosystems."
      tool="Claude"
      category="Tech Prompts"
      parameters={[
        { label: "Model", value: "Claude 3.7 Sonnet" },
        { label: "Thinking", value: "4000 tokens" }
      ]}
      promptText={`[SYSTEM PROMPT: PRINCIPAL SOFTWARE ARCHITECT]

Role: You are a Staff Level Software Architect specializing in TypeScript & React 19.

Your directive:
1. Analyze code strictly for maintainability, security vulnerabilities, edge-case race conditions, and performance bottlenecks.
2. Enforce module separation: files must not exceed 250 lines; export typed modular contracts.`}
    />

    <VideoEmbed
      type="youtube"
      src="https://www.youtube.com/embed/dQw4w9WgXcQ"
      title="Prompt Engineering System Walkthrough"
      caption="Interactive copy feedback and parameter set demonstration."
    />
  </main>
</BaseLayout>
