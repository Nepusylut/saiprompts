---
export interface Parameter {
  label: string;
  value: string;
  badgeType?: 'param' | 'version' | 'setting' | 'model';
}

export interface Props {
  id?: string;
  title: string;
  description?: string;
  tool: 'ChatGPT' | 'Claude' | 'Midjourney' | 'Suno' | 'Stable Diffusion' | 'Cursor' | 'DeepSeek' | 'General';
  category?: string;
  promptText: string;
  parameters?: Parameter[];
  tags?: string[];
  copyCount?: number;
  outputPreview?: {
    type: 'image' | 'code' | 'audio' | 'text';
    content: string;
    caption?: string;
  };
}

const {
  id = Math.random().toString(36).substr(2, 9),
  title,
  description,
  tool,
  category = 'AI Prompts',
  promptText,
  parameters = [],
  tags = [],
  copyCount = 1200,
  outputPreview
} = Astro.props;

const toolColors: Record<string, string> = {
  ChatGPT: 'bg-emerald-500/15 text-emerald-400 border-emerald-500/30',
  Claude: 'bg-amber-500/15 text-amber-400 border-amber-500/30',
  Midjourney: 'bg-indigo-500/15 text-indigo-400 border-indigo-500/30',
  Suno: 'bg-pink-500/15 text-pink-400 border-pink-500/30',
  'Stable Diffusion': 'bg-purple-500/15 text-purple-400 border-purple-500/30',
  Cursor: 'bg-cyan-500/15 text-cyan-400 border-cyan-500/30',
  DeepSeek: 'bg-blue-500/15 text-blue-400 border-blue-500/30',
  General: 'bg-slate-500/15 text-slate-400 border-slate-500/30'
};

const badgeClass = toolColors[tool] || toolColors.General;
---

<div id={`prompt-card-${id}`} className="group relative my-6 overflow-hidden rounded-xl border border-slate-800 bg-slate-950/90 shadow-2xl transition-all duration-300 hover:border-slate-700/80">
  {/* Header */}
  <div className="flex flex-wrap items-center justify-between gap-3 border-b border-slate-800/80 bg-slate-900/60 px-4 py-3 sm:px-5">
    <div className="flex items-center gap-2.5">
      <span className={`inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold tracking-wide ${badgeClass}`}>
        ★ {tool}
      </span>
      <span className="hidden text-xs font-medium text-slate-400 sm:inline-flex">
        {category}
      </span>
    </div>

    {/* One Click Copy Button Scripted */}
    <button
      data-prompt={promptText}
      onclick="
        const text = this.getAttribute('data-prompt');
        navigator.clipboard.writeText(text);
        const originalText = this.innerHTML;
        this.innerHTML = '<span>Copied! ✓</span>';
        this.classList.add('bg-emerald-500', 'text-slate-950');
        setTimeout(() => {
          this.innerHTML = originalText;
          this.classList.remove('bg-emerald-500', 'text-slate-950');
        }, 2000);
      "
      className="inline-flex items-center gap-2 rounded-lg bg-gradient-to-r from-violet-600 to-indigo-600 px-3.5 py-1.5 text-xs font-semibold text-white shadow-md hover:from-violet-500 hover:to-indigo-500 transition-all active:scale-95 cursor-pointer"
    >
      <span>Copy Prompt</span>
    </button>
  </div>

  {/* Title & Description */}
  <div className="px-4 pt-4 sm:px-5">
    <h4 className="text-base font-bold text-slate-100 sm:text-lg">{title}</h4>
    {description && <p className="mt-1 text-xs text-slate-400 sm:text-sm">{description}</p>}
  </div>



  {/* Code Block */}
  <div className="relative p-4 sm:p-5">
    <pre className="overflow-x-auto rounded-lg border border-slate-800/90 bg-slate-900/95 p-4 font-mono text-xs leading-relaxed text-slate-200 sm:text-sm whitespace-pre-wrap selection:bg-violet-600/40"><code>{promptText}</code></pre>
  </div>

  {/* Output Preview */}
  {outputPreview && outputPreview.type === 'image' && (
    <div className="p-4 sm:p-5 pt-0">
      <div className="overflow-hidden rounded-lg border border-slate-800 bg-slate-900">
        <img src={outputPreview.content} alt={outputPreview.caption || title} className="h-auto w-full max-h-96 object-cover" />
        {outputPreview.caption && <p className="bg-slate-950 px-3 py-2 text-center text-xs text-slate-400">{outputPreview.caption}</p>}
      </div>
    </div>
  )}
</div>
